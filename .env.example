# Public URL of the deployed site, without a trailing slash. Used for canonical
# URLs, hreflang, Open Graph, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://nadeem-marble.vercel.app

# Contact form email (EmailJS REST API, called from /api/contact on the server).
# Server-only: never prefix these with NEXT_PUBLIC_. Leave empty to fall back to
# the WhatsApp/email "prepare my enquiry" mode.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
